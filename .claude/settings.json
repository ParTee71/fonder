{
  "env": {
    "LC_ALL": "C.UTF-8"
  },
  "permissions": {
    "allow": [
      "mcp__github__subscribe_pr_activity",
      "mcp__github__unsubscribe_pr_activity",
      "mcp__github__pull_request_read",
      "mcp__github__get_check_run",
      "mcp__github__get_job_logs",
      "mcp__github__actions_get",
      "mcp__github__actions_list",
      "mcp__github__issue_read",
      "mcp__github__list_pull_requests",
      "mcp__github__list_issues",
      "mcp__github__search_issues",
      "mcp__github__search_pull_requests",
      "mcp__github__list_commits",
      "mcp__github__get_commit",
      "mcp__github__list_branches",
      "mcp__github__list_tags",
      "mcp__github__list_releases",
      "mcp__github__get_release_by_tag",
      "mcp__Claude_Code_Remote__subscribe_pr_activity",
      "mcp__Claude_Code_Remote__unsubscribe_pr_activity",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__Claude_Code_Remote__delete_trigger",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__fire_trigger",
      "mcp__Claude_Code_Remote__list_repos",
      "Bash(node --test .claude/hooks/test/*.test.mjs)",
      "Bash(node tools/regel4-baseline.mjs:*)",
      "mcp__claude-code-remote__subscribe_pr_activity",
      "mcp__claude-code-remote__unsubscribe_pr_activity",
      "mcp__claude-code-remote__send_later",
      "mcp__claude-code-remote__create_trigger",
      "mcp__claude-code-remote__update_trigger",
      "mcp__claude-code-remote__delete_trigger",
      "mcp__claude-code-remote__list_triggers",
      "mcp__claude-code-remote__fire_trigger",
      "mcp__claude-code-remote__list_repos"
    ],
    "deny": [
      "Read(**/*.jks)",
      "Read(**/keystore.properties)",
      "Read(**/*service-account*.json)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=$(ls \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh \"$CLAUDE_PROJECT_DIR\"/fonder/.claude/hooks/session-start.sh 2>/dev/null | head -n1); [ -z \"$f\" ] || \"$f\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(ls \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/regel4-check.mjs \"$CLAUDE_PROJECT_DIR\"/fonder/.claude/hooks/regel4-check.mjs 2>/dev/null | head -n1); [ -z \"$f\" ] || node \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=$(ls \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/regel4-check.mjs \"$CLAUDE_PROJECT_DIR\"/fonder/.claude/hooks/regel4-check.mjs 2>/dev/null | head -n1); [ -z \"$f\" ] || node \"$f\" --stop",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-android": {
      "source": {
        "source": "github",
        "repo": "ParTee71/claude-android"
      }
    }
  },
  "enabledPlugins": {
    "android@claude-android": true
  }
}
