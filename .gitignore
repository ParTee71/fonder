# Signeringsnycklar och lokal konfig — checka aldrig in
*.jks
*.keystore
local.properties

# OBS: app/google-services.json är medvetet INTE ignorerad. google-services-pluginet
# läser den vid varje bygge (den genererar bl.a. default_web_client_id), så utan filen
# i repot går CI-bygget inte att köra alls. Innehållet är projektnummer och
# OAuth-klient-ID:n som ändå ligger läsbara i den publicerade APK:n — skyddet ligger i
# SHA-1-kopplingen till signeringsnyckeln, inte i att filen är hemlig.
# Se docs/GOOGLE-SETUP.md.

# Undantag: fast debug-keystore, medvetet incheckad så alla CI-byggda debug-APK:er
# signeras med samma nyckel och kan installeras som uppgradering av varandra
# (Androids auto-genererade ~/.android/debug.keystore finns inte kvar mellan
# GitHub Actions-körningar, vilket annars ger en ny nyckel — och ett trasigt
# uppgraderingsflöde — varje gång). Lösenord/alias är de kända Android-standardvärdena
# ("android"/"androiddebugkey"), inte hemliga.
!app/debug.keystore

# Gradle / build
/.gradle/
/build/
/app/build/
.kotlin/

# IDE
/.idea/
*.iml
.DS_Store
