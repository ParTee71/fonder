<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Androids inbyggda Auto Backup (Google-kontots molnlagring) som interimistiskt
         skydd tills Drive-backupen (TP-7, NFR-1) är byggd — annars finns i dag inget sätt
         att återställa data efter en förlorad/nollställd enhet. fonder.db är litet, långt
         under 25 MB-kvoten.

         Regelfilerna pekas ut här, vilket de tidigare inte gjorde: backup_rules.xml fanns
         men refererades aldrig, så Auto Backup tog med *hela* datakatalogen. Det spelade
         ingen roll så länge inloggningen var en stub, men gör det i och med TP-6 — sedan
         dess persisterar firebase-auth en session i appens filer, och den ska varken till
         molnet eller till en ny enhet. Båda attributen behövs: fullBackupContent gäller
         API 30 (minSdk), dataExtractionRules API 31+. Listorna är include-listor, så
         skyddet är att sessionen inte står med — inte att den exkluderas. -->
    <application
        android:name=".FonderApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fonder"
        android:enableOnBackInvokedCallback="true">

        <!-- Stäng av standard-WorkManager-initieraren så vår HiltWorkerFactory används -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Fonder.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
